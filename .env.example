# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Project URL from your Supabase project dashboard (Settings > API)
SUPABASE_URL=

# SUPABASE_ANON_KEY: Client-safe anon/public key for querying Supabase
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Privileged service role key for backend database operations and migrations
SUPABASE_SERVICE_ROLE_KEY=

# SESSION_SECRET: High-entropy secret key (32+ bytes) for signing session tokens and CSRF protection
SESSION_SECRET=

# MFA_ENCRYPTION_KEY: 32-byte (64 hex chars) server-side key for AES-256-GCM encryption of TOTP secrets at rest
MFA_ENCRYPTION_KEY=

# EMAIL_PROVIDER_CONFIG: Optional — Skipped when no custom domain is owned.
# Can be added later once a custom domain is available.
# RESEND_API_KEY=
# EMAIL_FROM=

